   "text": "此集前編三冊は大人の俄にかきいでられたるをやがて人々のあへるまゝに板にゑらしめつるなり集中に國を𛁈るさぬ地名のこれかれいでたるは大人の故鄕の肥後國なるまゝ今の旅居の長崎のちかきあたりのなりかくて長歌集文集もかきづめられたるをつぎ〳〵板にゑらすべくはた此集の後編をもつぎでも此をべきにこそ天保十年正月廿八日筑紫のみちの𛁈りみつまの郡なる大石大神につかへまつる船曳大滋長崎の旅やどりに識す橿園歌集抄終",
   "poems": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "あけぼのゝまだほのかなる春の色をひとり𛁈めたる鶯の聲",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "氷ゐじいはまの〓水ながるめり春さつ風や𛁈るべしつらむ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "あつ氷ふきとく谷のはる風にみづの冬さへのこらざりけり",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "ふく風もなぎたる春の空の海にあさみつ玄ほい霰なりりり",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山のはいうづみはてぬる夕ぐれのかすみや鳥の塒なるらむ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "爲もなきていでにし谷の戶にいつまで雪のきえのこるらむ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "さく花のねぐらに風やわたるらむ曉ふかくうぐひすのなく",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "梅柳あずゑもわかぬあけぼのゝ霞をつたふうぐひすのこゑ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "もえわたる柳の色も一つにてけぶりながるゝ春のかはみづ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "稻荷山すぎの下みちうちつれてかすみをかざす春のもる人",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "いづる日の光の奥あなりおけり霞めるやまの松のむらだち",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "ゆけど猶花こそ見えね山賤の折りて出しやいづあなるらむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "人の身もあへず玄をるゝ山風の花ふいいかに吹むとすらむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "柴人にうちつれ歸るあげまきグはるのおも荷い蕨なりけり",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "みちのべの松比あげ野の下蕨やもらふまふも折はやしつゝ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "菫さくかきねの春になりぬれどとふ人もなしつむ人もなし",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "日ぐらしにつめどもあかぬ菫哉うべも雲雀の床を玄めける",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "あはれあも萠え出る艸の綠かな春きたりとも𛁈らぬ住家に",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "百鳥にあらそはじとや大空のかもみのうちに雲雀なくらむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "百とりいまだ聲たてぬ有明のそらさやかふもなく雲雀かな",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "春の雁かへる田のむの澤水にとまらぬ影をなにうつもらむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "なく聲のきゆる空まで慕はるゝ心も𛁈らずかりのゆくらむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "うちつれて歸る雁さへわかれぢの心細さをねみやなくらむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "きゝわびし松の玄づりの音かへて雨のどかなる山陰のいほ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "さえ〓〓し光かすみて長閑なる月の春おもなりにけるかな",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "行方なき物ともゑらで吹く風にはかなく花のたぐひ初けむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "けふも又さそひ〓〓て山かぜのはていものうくちる櫻かな",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "たぐひなく見えし花哉ゆめの內に分し野山や何處なりけむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "春いたヾ花の處をとひ〓〓て友なき身こそともいありけれ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "人いみなかへりし木かげ靜あていよ〓〓はなにそむ心かな",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "春雨のはるれバ風Hふきたちて見るまもくなきはな盛かな",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "苗代あせきよどめたる山水の比どかに見ゆるはなのいろ哉",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "岩ばしる瀧の上しもあやにくにたをりまげなる花の枝かな",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "雲に入るとりの翅もにほふらむよしの高ねの花のさかりい",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "移ろはバいかにせむとてさく花にさしもなづさふ心なるらむ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "さきしより櫻が中に身をかきて花より外の世を𛁈らぬかな",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "花さそふ嵐を何にうらみけむ枝なグらこそひとい折りけれ",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "ゆさりなるはるの霞の袂よりあまるい花のおほひなりけり",
   "kana": "",
   "speaker": "",
   "page": 219,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "中々による比雨みや云をるらむ照日にたへしなでしこの花",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "色みえぬひとの心の鬼あざみ花やかへりてうたておもはむ",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "梅雨にまさりし水もおちぬめり淺ざはぬまのあさゝ花さく",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "あげまきグ打落したる水の上を𛁈ばし流れてとぶほたる哉",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "あらはれてもゆる思を何にまさをり〓〓𛁈のぶ螢なるらむ",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "おく露のひかり見えゆく曙のやま田のはらに水雞をくなり",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "むら雲の中にある日の影見れバまだ暮とほし五月雨のそら",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "いぶせしや眞柴ふすぷる軒端より烟に似たる雨ぞふりいる",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "賤のをが麥かりほせる山畑のたち木のあふち花さきおけり",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "さけバかつなつかしき哉棟原はなといふ程H花ならねども",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "千町田にうつる夕日の影きえてはるかになりぬさ苗とる聲",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "むら雨の雲ふきおくる夕風に山ほとゝぎすこゑむせぶなり",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "谷ふかみあゐをたゝへし岩淵の水さへ白くさけるうのはな",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "卯花のさきちる岸をとめくれバ岩瀨のなみに小鮎さばしる",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "子雀のあを葉グくれふなく聲もまだうら若き軒のならしば",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "きて見れび昔の庭をはる野みて菫つめるや誰グ子なるらん",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "葉がくれおめじろ囀る聲すなりつばきまじりの春のみ山木",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "おもしろき春の盛をことさらにすぐしてさける藤なみの花",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "口なしの色にさきたる山吹のおもひありげに露ぞこぼるヽ",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "とふ人にけふもをられぬ我宿のまがきと賴むやまぶきの花",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "思ふこといはぬ色とて枝さへもうち𛁈なひさる山吹のばな",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "苗代のみづせみなかみ來て見れバ杜若さく野ざはなりけり",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "鶯北さへづる野邊のいづこまでさそはれわたる心なるらむ",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "いつしかと水寒からもなりにりり靑みわされる小田の苗代",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "苗代のとき來にけらし小山田の柳のさえだきりおろすめり",
   "kana": "",
   "speaker": "",
   "page": 220,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "霧はるゝと山の秋のそらすみて木末玄づけき鳥のひとこゑ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "波のおとい下にさわぎて明る夜の霧玄づかなる木曾の山川",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "なく虫の聲ばかりあそ聞えけれふけわたりぬる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "衣うつわら屋も見えて一すぢの秋かぜさむし竹のなかみち",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "かげふかき槇の下道ふきおくるうき雲はやし秋のやまかぜ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "百くさの花の心をたゴねてやおのがいろ〓〓露もおくらむ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "ふきよする荒磯波をさながらに尾ばなにうつす秋の浦かぜ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "打おびく荻のほだちにまつはれて秋風そよぐ朝がほのはな",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "あやなくもとまる心かはな薄なべての人をまねくたもとに",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "さを鹿のわたりすぎたる山水にちりて流るゝ秋はぎのはな",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "かきわけて歸らむ方も思ほえずゆふ露なびく小野比はぎ原",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "天の川あきたつ波のすゞしきにすヾ舟よそひ今やこぐらむ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "彥星のわたるほどをや照すらむ天のかは瀨のゆふ月のかげ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "星まつる庭の燈火まさゝきてふくる夜すヾし秋のはつかぜ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "秋風ハ故さと人のなにおれやふきそむるより戀しかるらむ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "蓬生いをむ人なゆふ見えぬらむさも打つけにきたる秋かな",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "まつら川かはせ凉しき夕なミに駒うちいれて水かふやたれ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "夏ごろもとほりし汗もか〓きけり並木の松の風の玄たみち",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "水かれし夏の山田のむらさめいたみの心にそゝぐなりけり",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "梅雨のいぶせかりしも今更にこひしきばかりてる日影がな",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "おく露もたわゝに靡く若竹おわりなくすがるかたつぶり哉",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "辛崎のうらわのみ秡はておけり松にふきたつ秋かぜのこゑ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "夕波にこぎ出る舟のすゞしきい汀やなつのかぎりなるらむ",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "み山路にのりつからせる〓ググを進めがほなる蟬の聲かな",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "いづ方にたくともなくて蚊遣火の烟にくもる夕ぐれのさと",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "さいら波ほのくれわたる川づらの里わに𛁈ろき夕がほの花",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "日ぐらしのなく山かげの小柴垣玄ろく見ゆるや夕顏のはな",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "かはほりの風にたゞよふ姿さへ涼しく見ゆる夏の夜のつき",
   "kana": "",
   "speaker": "",
   "page": 221,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "秋ふけて色づくあふち實を多みもりはむ鳥の絕る間ぞなき",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "くれぬまに霜とやならむ野べの露はかなの秋の忘れ形見や",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "そむるよりそむる心いもみぢ葉の外に又玄る人なかりけり",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "蛬なきよるかべのあなさあも夜さむゑらせてころもうつん",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "舟出して誰か見るらむあし北の野ざかの浦の秋の夜のつき",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "はこね山秋の夜ふかき海の色のあまりにすごくすめる月哉",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "虫のねみまがふ水の音とめくれバ細き流につきぞすみたる",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "見るからゐ淚ぞおつる秋の月もみはつまじき此世と思ふふ",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "むら蘆の玄げみにきほふ虫のねの中よりいづる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "ふきおくる嵐の雲のひまごとにかげあらたまる月を見る哉",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "いづ方に月いいづらむおぼつかな山の端くらき松風のおと",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "わかの浦の蘆の亂れ葉浪こえてみちくる汐に千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "夜嵐のはらふまさごの霜の上におりたちかねてなく千鳥哉",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "さゆる夜の月に碎くる川なみい氷れるよりも寒けかりけり",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "霜枯の入江のあしのみざれ葉にのあるも寒き風せおとかな",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "木枯の時雨をさそふ山のはのむら雲くろくてるつき夜かな",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "うかりける峯の嵐もなか〓〓ふかくてうれしき松の落葉り",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "嵐ふく片山蔭のいさらゐいちるもみぢ葉をくまぬ日ぞなき",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "流れくる水もいろ〓〓に匂ふめり紅葉の木のま菊の下かげ",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "更になど驚かすらむさよ時雨かねてさめたる老のねぶりを",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "ふきおくる嵐のくもの絕間より時雨をてらす夕コく日かな",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "かきくらす時雨の空にとぶさぎの羽色さやかに入日さを也",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "あしびきの片山嵐おとクへてあわたゞしくもきたる冬かな",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "秋ふけて色づく見れバかさ岡の松のあなさい山田なりけり",
   "kana": "",
   "speaker": "",
   "page": 222,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "たちかへり今一言やいひてましまだ夜い深きみちしばの露",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "月いなほかこちよすべき有明にうたて急グすとりの聲かな",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "うれしきに何か心のさわぐらむたのめおきつる夕暮のそら",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "つれなくいさてもありなむ何にかくうき水莖比跡を見すらむ",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "いとゞしくまとふ心を一目みバ慰むべくもおもひけるかな",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "今更に何うちいでむとはとつる昔もこめてすぎしたもひを",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "山深きくち木のうつぼふり埋むみ雪を寒みましらなくなり",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "之づの男が芥くゆらす山畑の冬木のうれにひたき鳴くなり",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "雪あられふるといおしに立迷ふ雲此けしきの寒きふゆかな",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "霜どけのかわくばかりい照もせで早くかげろふ夕づく日哉",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "松の葉もつひにもみぢてあはれなる燒野比原の年の暮かな",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "たが宿をとひて長閑に語らはむいそがしげなる年北暮かな",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "くれてゆく一年毎にみじかさせまさるや老の增るなるらむ",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "霜がれの一つ木立とかもひつるをかべの梅の花さきおけり",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "さゆる夜い埋火にのみ向ふかなおれし机もかたはらにして",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "冬ごもるよその山べの寒けさをおのが時なるすみがまの里",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "たちよらむ木がくれもなき山路哉ふりしきる雪ふき迷ふ風",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "世中のかしがましさにかへてきく霞の音れさやりなるかな",
   "kana": "",
   "speaker": "",
   "page": 223,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "なぎにける風のけしきをふくる夜の枕の浪の音に𛁈るかな",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "舟はてしこれやいづこの浦ならむ枕に近き海士のさへづり",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "碇網おろすひヾきの久しきをまくらにきくもあゝろ細しや",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "あるいそひあるい離れて大木曾の山川比ずり幾日きぬらむ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "たれかまた末野の草を結ぶらむ一つかりほふねなまし物を",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "宿るべき里い麓に見えながらくだれが遠きいはのかけみち",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "うき旅の心ぼそさをふる里に思ふや千々のひとつなるらむ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "悔しくも老にけるかな此たびの友の數あいいらまほしきお",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "山もとの竹の一むらひとすぢ比道おくふりし誰りもむらむ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "靜なるいはねの水のひいきかなこれや心のもみかなるらむ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "けふもまた筧玄たゞるま〓水にはね打そゝぎ遊ぶむらとり",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "とふ人の歸る送りてめづらしくときさへ〓たる谷のいは橋",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "遠近に殘る家居比幾ほどもあらし吹く野となりやはてなむ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "萬代をむかし契りしたがならむ野となる里の松のひともと",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "浪よせい流せぬべくもみゆる哉はりなの蟹比浦比もとうや",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "大空もひとつみどりの波比上いつりいづこに舟いはつらむ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "まつらの海浪もひれふる朝嵐に漕出し船ぞおきにたゆたふ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "夜をこめて漕いでし湊けさ見れバ浪まはるかに山ぞ殘れる",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "かちとりの謠ふ夜聲もゆさりふて追風玄るき浪のおとかな",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "つかれたる足やもめるいまつ程の久しき舟も嬉しかりけり",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "夜を深み呼ぶに答へてわたり守猶ねぶるらむ梶比音もせぬ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "われとセグ心にとひてわくるかな深きはやしの苔のほそ道",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "風ふかで折々おつる杉の實北おともさびしき谷の之たみづ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "ひさかたの天つみ空にふる雪のいく世積れる高ねなるらむ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "ふく風も限ありけりはやくゆく雲よりうへの雲比玄づけさ",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "·和人のきりさくまきのいさづらにうもき心をたのみける哉",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "岩がねの千重に隔つる山よりもさのしきものい戀路えけり",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "雁なきて月かげさむき秋の夜を獨ながめてなほあかせとや",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "みつしほの瀨戶の渦まき猶早し追手の帆風ゆるみあらもな",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "ましらなく聲もよどまぬ山川を一日おくだる舟路いくさと",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "ひきのぼる綱手苦しき川舟の下るいやもき世にこそ有けれ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "ひるとれどあかぬ川路を淀舟の夜深くれみもひきのやる哉",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "里見ゆる磯山さしてこぐ卅をむかへ顏なるかねのおとかな",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "いづかたのさがすむ峰の寺ならむ夕ゐる雲に鐘比音ぞする",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "わけくだる山い麓になりぬらし松より下比もぎのむらだち",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "扨も世にとまらむ事いかたつぶり家をおひつゝいづちゆくらむ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "山深くこるやつま木の妻も子も同じゑわざに世を渡りつゝ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "狸もらおもふ心いありあけのつき〓〓しくもうたつやみ哉",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "古へをひきつたへたるつま琴の高きゑらべい神ぞゑるらむ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "白玉をふくめる石いあらめども抱きつゝ泣く人やなからむ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "ふる雨にこもきる老比つれ〓〓よ昔なりせバ簑かさにして",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "あやなくも心を千々にくだく哉むかしを今に思ひあつめて",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "人言北さがにくき世い中々に隱れさる名をうれしとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "弓のつか劍比たかみそれならぬ筆とりならし身い老あけり",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "山かげも何クもとめむよの中い心からこそすみうかりけれ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "思ふ事をるしおくこそはかなけれ我世の後の人をまつとて",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "あもをまた賴む心のはかなさよすぐれバけふの夕暮のそら",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "さま〓〓にうつる思の末きえてはかなき物ハ寐覺なりけり",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "いゴ方の雲井をさして歸るらむ我をともなへ天のたづむら",
   "kana": "",
